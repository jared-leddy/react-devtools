{
    "name": "@devtools/vite-playground",
    "version": "0.0.3",
    "private": true,
    "license": "UNLICENSED",
    "description": "Vite-based playground for exercising the React DevTools Vite plugin delivery mode.",
    "type": "module",
    "scripts": {
        "start:dev": "vite --port 3030",
        "build": "vite build",
        "lint": "eslint . --max-warnings=0",
        "test:unit": "jest --coverage --config jest.config.ts",
        "test:watch": "jest --coverage --watch --config jest.config.ts",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@devtools/vite-plugin": "*",
        "react": "^19.1.1",
        "react-dom": "^19.1.1"
    },
    "devDependencies": {
        "@devtools/typescript-config": "*",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.0.0",
        "@types/react": "19.1.11",
        "@types/react-dom": "19.1.7",
        "@typescript-eslint/eslint-plugin": "^8.40.0",
        "@typescript-eslint/parser": "^8.40.0",
        "@vitejs/plugin-react": "^5.0.0",
        "eslint": "^9.34.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "identity-obj-proxy": "^3.0.0",
        "jest": "^30.1.3",
        "jest-environment-jsdom": "^30.2.0",
        "ts-jest": "^29.4.4",
        "typescript": "^5.9.2",
        "vite": "^7.0.0"
    }
}
