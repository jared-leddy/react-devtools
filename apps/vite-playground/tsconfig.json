{
    "extends": "@devtools/typescript-config/base.json",
    "compilerOptions": {
        "jsx": "react-jsx",
        "lib": ["DOM", "DOM.Iterable", "ES2022"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noEmit": true,
        "baseUrl": ".",
        "paths": {
            "@devtools/kit": ["../../packages/devtools-kit/src/index.ts"],
            "@devtools/nekuta-plugin": [
                "../../packages/devtools-plugin-nekuta/src/index.ts"
            ],
            "@devtools/react-router-plugin": [
                "../../packages/devtools-react-router-plugin/src/index.ts"
            ]
        },
        "resolveJsonModule": true,
        "strict": true,
        "target": "ES2022",
        "types": ["node", "vite/client"]
    },
    "include": ["src", "tests", "jest.setup.ts", "vite.config.ts"]
}
