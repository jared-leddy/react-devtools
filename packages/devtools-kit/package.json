{
    "name": "@devtools/kit",
    "version": "0.0.8",
    "private": true,
    "license": "UNLICENSED",
    "description": "Core hook, transport, and plugin primitives for React DevTools.",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc",
        "lint": "eslint . --max-warnings=0",
        "prototype:global-hook": "node prototypes/react-global-hook-coexistence.mjs",
        "prototype:messaging": "npm run build && node prototypes/messaging-roundtrip.mjs",
        "test:unit": "jest --coverage --config jest.config.ts",
        "test:watch": "jest --coverage --watch --config jest.config.ts",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@devtools/shared": "*",
        "birpc": "^4.2.0",
        "hookable": "^6.1.1",
        "superjson": "^2.2.6",
        "vite-hot-client": "^2.2.0"
    },
    "devDependencies": {
        "@devtools/eslint-config": "*",
        "@devtools/jest-config": "file:../../packages/jest-config",
        "@devtools/typescript-config": "*",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.0.0",
        "@typescript-eslint/eslint-plugin": "^8.40.0",
        "@typescript-eslint/parser": "^8.40.0",
        "eslint": "^9.34.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "jest": "^30.1.3",
        "ts-jest": "^29.4.4",
        "typescript": "^5.9.2"
    }
}
