{
    "name": "@devtools/client",
    "version": "0.0.22",
    "private": false,
    "license": "UNLICENSED",
    "description": "React DevTools panel client shell.",
    "type": "module",
    "main": "./dist/library/devtools-client.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/library/devtools-client.js"
        },
        "./style.css": "./dist/library/style.css"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "start:dev": "vite --config vite.config.ts --port 3050",
        "build": "npm run build:library && npm run build:standalone && tsc --emitDeclarationOnly --outDir dist/types",
        "build:library": "vite build --config vite.lib.config.ts",
        "build:standalone": "vite build --config vite.config.ts",
        "lint": "eslint . --max-warnings=0",
        "test:unit": "jest --coverage --config jest.config.ts",
        "test:watch": "jest --coverage --watch --config jest.config.ts",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@devtools/api": "*",
        "@devtools/kit": "*",
        "@devtools/ui": "*",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "react-router": "^7.9.1",
        "react-window": "^2.3.3"
    },
    "devDependencies": {
        "@devtools/eslint-config": "*",
        "@devtools/typescript-config": "*",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.0.0",
        "@types/react": "19.1.11",
        "@types/react-dom": "19.1.7",
        "@typescript-eslint/eslint-plugin": "^8.40.0",
        "@typescript-eslint/parser": "^8.40.0",
        "@vitejs/plugin-react": "^5.0.0",
        "eslint": "^9.34.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "identity-obj-proxy": "^3.0.0",
        "jest": "^30.1.3",
        "jest-environment-jsdom": "^30.2.0",
        "ts-jest": "^29.4.4",
        "typescript": "^5.9.2",
        "vite": "^7.0.0"
    }
}
