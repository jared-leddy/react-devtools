{
    "extends": "@devtools/typescript-config/base.json",
    "compilerOptions": {
        "jsx": "react-jsx",
        "lib": ["DOM", "DOM.Iterable", "ES2022"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noEmit": true,
        "strict": true,
        "target": "ES2022",
        "types": ["node"]
    },
    "include": [
        "e2e",
        "src",
        "tests",
        "jest.setup.ts",
        "playwright.config.ts",
        "vite.config.ts"
    ]
}
