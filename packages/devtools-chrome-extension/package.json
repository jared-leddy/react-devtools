{
    "name": "@devtools/chrome-extension",
    "version": "0.0.7",
    "private": false,
    "license": "UNLICENSED",
    "description": "Chrome extension shell for React DevTools.",
    "type": "module",
    "main": "./dist/popup.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./style.css": "./dist/style.css"
    },
    "files": [
        "dist",
        "CHROME_MANUAL_VERIFICATION.md"
    ],
    "scripts": {
        "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly --outDir dist",
        "lint": "eslint . --max-warnings=0",
        "test:e2e": "playwright test --config playwright.config.ts",
        "test:unit": "jest --coverage --config jest.config.ts",
        "test:watch": "jest --coverage --watch --config jest.config.ts",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@devtools/kit": "*",
        "@devtools/ui": "*",
        "react": "^19.1.1",
        "react-dom": "^19.1.1"
    },
    "devDependencies": {
        "@devtools/eslint-config": "*",
        "@devtools/typescript-config": "*",
        "@playwright/test": "^1.63.0",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.0.0",
        "@types/react": "19.1.11",
        "@types/react-dom": "19.1.7",
        "@typescript-eslint/eslint-plugin": "^8.40.0",
        "@typescript-eslint/parser": "^8.40.0",
        "@vitejs/plugin-react": "^5.0.0",
        "eslint": "^9.34.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "identity-obj-proxy": "^3.0.0",
        "jest": "^30.1.3",
        "jest-environment-jsdom": "^30.2.0",
        "ts-jest": "^29.4.4",
        "typescript": "^5.9.2",
        "vite": "^7.0.0"
    }
}
