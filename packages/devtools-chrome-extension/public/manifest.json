{
    "manifest_version": 3,
    "name": "React DevTools",
    "description": "Inspect React apps with the rebuilt React DevTools extension.",
    "version": "0.0.2",
    "minimum_chrome_version": "102",
    "action": {
        "default_popup": "popup.html",
        "default_title": "React DevTools"
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "devtools_page": "devtools.html",
    "permissions": ["activeTab"],
    "content_scripts": [
        {
            "matches": ["http://*/*", "https://*/*"],
            "js": ["prepare.js"],
            "run_at": "document_start",
            "all_frames": true,
            "world": "MAIN"
        },
        {
            "matches": ["http://*/*", "https://*/*"],
            "js": ["proxy.js"],
            "run_at": "document_start",
            "all_frames": true,
            "world": "ISOLATED"
        }
    ],
    "content_security_policy": {
        "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; object-src 'none'; base-uri 'self'; frame-src 'self'; child-src 'self'; connect-src 'self'; frame-ancestors 'none'"
    }
}
