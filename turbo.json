{
    "$schema": "https://turborepo.dev/schema.json",
    "globalDependencies": ["**/.env.*"],
    "globalPassThroughEnv": ["SENTRY_AUTH_TOKEN", "SENTRY_DSN"],
    "tasks": {
        "start:dev": {
            "cache": false,
            "env": ["NODE_ENV", "PORT", "SENTRY_AUTH_TOKEN", "SENTRY_DSN"],
            "inputs": ["$TURBO_DEFAULT$", ".env.development"],
            "persistent": true
        },
        "build": {
            "dependsOn": ["^build"],
            "env": ["NODE_ENV", "PORT", "SENTRY_AUTH_TOKEN", "SENTRY_DSN"],
            "inputs": ["$TURBO_DEFAULT$", ".env.production"],
            "outputs": ["dist/**"]
        },
        "@devtools/docs#build": {
            "dependsOn": ["^build"],
            "outputs": ["build/**"]
        },
        "@devtools/playground#build": {
            "dependsOn": ["^build"],
            "outputs": [".next/**", "!.next/cache/**"]
        },
        "@devtools/playground#typecheck": {
            "dependsOn": ["^build", "build"],
            "outputs": [".next/types/**"]
        },
        "lint": {},
        "typecheck": {
            "dependsOn": ["^build"]
        },
        "test:unit": {
            "dependsOn": ["^build"],
            "outputs": ["coverage/**"]
        },
        "test:e2e": {}
    }
}
