{
    "name": "react-devtools",
    "version": "0.1.8",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "turbo build",
        "build:docs": "npx turbo run build --filter=@devtools/docs",
        "check:bundles": "turbo build --filter=@devtools/client --filter=@devtools/devtools-overlay --filter=@devtools/chrome-extension --filter=@devtools/firefox-extension && node scripts/check-bundles.mjs",
        "test:bundle-checks": "node --test --experimental-test-coverage --test-coverage-include=scripts/bundle-checks.mjs --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 scripts/bundle-checks.test.mjs",
        "extensions:package": "node scripts/extension-release.mjs package",
        "extensions:prepare": "node scripts/extension-release.mjs prepare",
        "extensions:version": "node scripts/extension-release.mjs version",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,md}\" scripts/bundle-checks.mjs scripts/check-bundles.mjs scripts/bundle-checks.test.mjs scripts/eslint.config.mjs scripts/bundle-budgets.json",
        "lint": "turbo lint && eslint --config scripts/eslint.config.mjs scripts/bundle-checks.mjs scripts/check-bundles.mjs scripts/bundle-checks.test.mjs",
        "postinstall": "simple-git-hooks",
        "start:dev": "turbo start:dev",
        "test:e2e": "turbo test:e2e",
        "test:product-smoke": "turbo build --filter=@devtools/vite-playground^... && npm run test:e2e --workspace=@devtools/vite-playground",
        "test:firefox-uat-helper": "node --test scripts/firefox-temporary-addon-uat.test.mjs",
        "test:release-packaging": "node --test scripts/extension-release.test.mjs",
        "test:unit": "turbo test:unit",
        "test:types": "turbo test:types --filter=@devtools/api",
        "typecheck": "turbo typecheck && npm run test:types"
    },
    "devDependencies": {
        "eslint": "^9.34.0",
        "vite": "^7.0.0",
        "conventional-changelog": "^8.1.3",
        "conventional-changelog-angular": "^9.4.0",
        "gulp": "^5.0.1",
        "prettier": "^3.6.2",
        "semver": "^7.8.5",
        "simple-git-hooks": "^2.13.1",
        "turbo": "^2.10.9"
    },
    "simple-git-hooks": {
        "pre-commit": "npx gulp lintStaged"
    },
    "packageManager": "npm@11.13.0",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "overrides": {
        "react": "19.1.1",
        "react-dom": "19.1.1"
    },
    "allowScripts": {
        "@sentry/cli": true,
        "argon2": true,
        "sharp": true,
        "esbuild": true,
        "core-js": true,
        "@heroui/shared-utils": true,
        "unrs-resolver": true,
        "@parcel/watcher": true
    }
}
